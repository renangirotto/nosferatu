---
import type { HTMLAttributes } from "astro/types";
import type { ColorPalette, IconComponent } from "../types/components";
/*
 * Iconoir is a dependency of this package, so these resolve from here under
 * any package manager and the consumer installs nothing for the defaults.
 */
import Plus from "iconoir/icons/regular/plus.svg";
import Minus from "iconoir/icons/regular/minus.svg";

interface Props extends HTMLAttributes<"details"> {
	summary: string;
	color?: ColorPalette;
	/* Shown while closed, in place of the plus */
	iconCollapsed?: IconComponent;
	/* Shown while open, in place of the minus */
	iconExpanded?: IconComponent;
}

const {
	summary,
	color,
	iconCollapsed: Collapsed,
	iconExpanded: Expanded,
	class: className,
	"data-ui-color": _controlled,
	...attrs
} = Astro.props;
---

<details
	{...attrs}
	data-ui-color={color}
	class:list={["nf-accordion", className]}
>
	<summary class="nf-accordion-summary">
		<span class="nf-accordion-label">{summary}</span>
		{/* The summary already exposes the expanded state, so both icons are decorative */}
		<span class="nf-accordion-icon" aria-hidden="true">
			<span class="nf-accordion-icon-collapsed">
				{Collapsed ? <Collapsed /> : <Plus width="1em" height="1em" />}
			</span>
			<span class="nf-accordion-icon-expanded">
				{Expanded ? <Expanded /> : <Minus width="1em" height="1em" />}
			</span>
		</span>
	</summary>
	<div class="nf-accordion-content">
		<slot />
	</div>
</details>

<style>
	.nf-accordion {
		--nf-accordion-depth: 4px;
		--nf-accordion-lift: 0px;
		--nf-accordion-border-width: 2px;
		/* 24px against the 1rem summary, at the default root size */
		--nf-accordion-icon-size: 1.5rem;
		--nf-accordion-transition-duration: 0.15s;
		--nf-accordion-disclosure-duration: 0.3s;

		/* The depth belongs to the whole panel, so it shows closed and open alike */
		border-radius: var(--nf-border-radius-base);
		box-shadow: 0px var(--nf-accordion-depth) 0px
			var(
				--nf-accordion-shadow-color,
				light-dark(var(--nf-grey-l-70), var(--nf-grey-d-80))
			);

		&[data-ui-color="blue"] {
			--nf-accordion-color: light-dark(
				var(--nf-blue-l-40),
				var(--nf-blue-d-50)
			);
			--nf-accordion-accent-color: light-dark(
				var(--nf-blue-l-80),
				var(--nf-blue-d-90)
			);
			--nf-accordion-shadow-color: light-dark(
				var(--nf-blue-l-70),
				var(--nf-blue-d-80)
			);
			--nf-accordion-rule-color: light-dark(
				var(--nf-blue-l-60-25),
				var(--nf-blue-d-70-25)
			);
		}

		&[data-ui-color="cyan"] {
			--nf-accordion-color: light-dark(
				var(--nf-cyan-l-40),
				var(--nf-cyan-d-50)
			);
			--nf-accordion-accent-color: light-dark(
				var(--nf-cyan-l-80),
				var(--nf-cyan-d-90)
			);
			--nf-accordion-shadow-color: light-dark(
				var(--nf-cyan-l-70),
				var(--nf-cyan-d-80)
			);
			--nf-accordion-rule-color: light-dark(
				var(--nf-cyan-l-60-25),
				var(--nf-cyan-d-70-25)
			);
		}

		&[data-ui-color="green"] {
			--nf-accordion-color: light-dark(
				var(--nf-green-l-40),
				var(--nf-green-d-50)
			);
			--nf-accordion-accent-color: light-dark(
				var(--nf-green-l-80),
				var(--nf-green-d-90)
			);
			--nf-accordion-shadow-color: light-dark(
				var(--nf-green-l-70),
				var(--nf-green-d-80)
			);
			--nf-accordion-rule-color: light-dark(
				var(--nf-green-l-60-25),
				var(--nf-green-d-70-25)
			);
		}

		&[data-ui-color="grey"] {
			--nf-accordion-color: light-dark(
				var(--nf-grey-l-40),
				var(--nf-grey-d-50)
			);
			--nf-accordion-accent-color: light-dark(
				var(--nf-grey-l-80),
				var(--nf-grey-d-90)
			);
			--nf-accordion-shadow-color: light-dark(
				var(--nf-grey-l-70),
				var(--nf-grey-d-80)
			);
			--nf-accordion-rule-color: light-dark(
				var(--nf-grey-l-60-25),
				var(--nf-grey-d-70-25)
			);
		}

		&[data-ui-color="orange"] {
			--nf-accordion-color: light-dark(
				var(--nf-orange-l-40),
				var(--nf-orange-d-50)
			);
			--nf-accordion-accent-color: light-dark(
				var(--nf-orange-l-80),
				var(--nf-orange-d-90)
			);
			--nf-accordion-shadow-color: light-dark(
				var(--nf-orange-l-70),
				var(--nf-orange-d-80)
			);
			--nf-accordion-rule-color: light-dark(
				var(--nf-orange-l-60-25),
				var(--nf-orange-d-70-25)
			);
		}

		&[data-ui-color="pink"] {
			--nf-accordion-color: light-dark(
				var(--nf-pink-l-40),
				var(--nf-pink-d-50)
			);
			--nf-accordion-accent-color: light-dark(
				var(--nf-pink-l-80),
				var(--nf-pink-d-90)
			);
			--nf-accordion-shadow-color: light-dark(
				var(--nf-pink-l-70),
				var(--nf-pink-d-80)
			);
			--nf-accordion-rule-color: light-dark(
				var(--nf-pink-l-60-25),
				var(--nf-pink-d-70-25)
			);
		}

		&[data-ui-color="purple"] {
			--nf-accordion-color: light-dark(
				var(--nf-purple-l-40),
				var(--nf-purple-d-50)
			);
			--nf-accordion-accent-color: light-dark(
				var(--nf-purple-l-80),
				var(--nf-purple-d-90)
			);
			--nf-accordion-shadow-color: light-dark(
				var(--nf-purple-l-70),
				var(--nf-purple-d-80)
			);
			--nf-accordion-rule-color: light-dark(
				var(--nf-purple-l-60-25),
				var(--nf-purple-d-70-25)
			);
		}

		&[data-ui-color="red"] {
			--nf-accordion-color: light-dark(var(--nf-red-l-40), var(--nf-red-d-50));
			--nf-accordion-accent-color: light-dark(
				var(--nf-red-l-80),
				var(--nf-red-d-90)
			);
			--nf-accordion-shadow-color: light-dark(
				var(--nf-red-l-70),
				var(--nf-red-d-80)
			);
			--nf-accordion-rule-color: light-dark(
				var(--nf-red-l-60-25),
				var(--nf-red-d-70-25)
			);
		}

		&[data-ui-color="yellow"] {
			--nf-accordion-color: light-dark(
				var(--nf-yellow-l-40),
				var(--nf-yellow-d-50)
			);
			--nf-accordion-accent-color: light-dark(
				var(--nf-yellow-l-80),
				var(--nf-yellow-d-90)
			);
			--nf-accordion-shadow-color: light-dark(
				var(--nf-yellow-l-70),
				var(--nf-yellow-d-80)
			);
			--nf-accordion-rule-color: light-dark(
				var(--nf-yellow-l-60-25),
				var(--nf-yellow-d-70-25)
			);
		}
	}

	/*
	 * The raised control: the text at the start, the icon at the end. It has no
	 * shadow of its own — it slides down over the panel's shadow to read as pressed.
	 */
	.nf-accordion-summary {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--nf-spacing-base-low-2);
		border: none;
		/*
		 * Always 2px, so opening never changes the summary's height: invisible
		 * against the fill while closed, the rule color while open.
		 */
		border-block-end: var(--nf-accordion-border-width) solid
			var(
				--nf-accordion-color,
				light-dark(var(--nf-grey-l-40), var(--nf-grey-d-50))
			);
		border-radius: var(--nf-border-radius-base);
		padding-block: var(--nf-spacing-base-low-2);
		padding-inline: var(--nf-spacing-base);
		color: var(
			--nf-accordion-accent-color,
			light-dark(var(--nf-grey-l-80), var(--nf-grey-d-90))
		);
		font-weight: 600;
		background-color: var(
			--nf-accordion-color,
			light-dark(var(--nf-grey-l-40), var(--nf-grey-d-50))
		);
		list-style: none;
		translate: 0 var(--nf-accordion-lift);
		cursor: pointer;
		transition-property: translate, background-color, color, border-color;
		transition-duration: var(--nf-accordion-transition-duration);
		transition-timing-function: ease-in-out;

		/* Safari still paints the marker without this */
		&::-webkit-details-marker {
			display: none;
		}

		&:hover,
		&:focus-within {
			--nf-accordion-lift: 1px;
		}

		&:active {
			--nf-accordion-lift: 4px;
		}

		/* Drawn inside the summary's edge, so it reads as a border on it */
		&:focus-visible {
			outline: var(--nf-accordion-border-width) solid
				var(
					--nf-accordion-accent-color,
					light-dark(var(--nf-grey-l-80), var(--nf-grey-d-90))
				);
			outline-offset: calc(-1 * var(--nf-accordion-border-width));
		}
	}

	/*
	 * After the hover and active rules on purpose: an open summary stays put
	 * whatever the pointer is doing, sitting on its rule with square bottom
	 * corners against the content below.
	 */
	.nf-accordion[open] .nf-accordion-summary {
		--nf-accordion-lift: 0px;

		border-block-end-color: var(
			--nf-accordion-rule-color,
			light-dark(var(--nf-grey-l-60-25), var(--nf-grey-d-70-25))
		);
		border-end-start-radius: 0;
		border-end-end-radius: 0;
	}

	/*
	 * One line of the summary tall, at the summary's own font size, so the icon
	 * centres on the first line when the text wraps. The icon parts carry the
	 * icon size, so content sized in em follows --nf-accordion-icon-size.
	 */
	.nf-accordion-icon {
		display: flex;
		flex: none;
		align-items: center;
		block-size: 1lh;
	}

	.nf-accordion-icon-collapsed,
	.nf-accordion-icon-expanded {
		display: flex;
		font-size: var(--nf-accordion-icon-size);
	}

	.nf-accordion-icon-expanded {
		display: none;
	}

	.nf-accordion[open] .nf-accordion-icon-collapsed {
		display: none;
	}

	.nf-accordion[open] .nf-accordion-icon-expanded {
		display: flex;
	}

	/* The inside of the control: same fill, same accent, no shadow of its own */
	.nf-accordion-content {
		border-end-end-radius: var(--nf-border-radius-base);
		border-end-start-radius: var(--nf-border-radius-base);
		padding-block: var(--nf-spacing-base-low-2);
		padding-inline: var(--nf-spacing-base);
		color: var(
			--nf-accordion-accent-color,
			light-dark(var(--nf-grey-l-80), var(--nf-grey-d-90))
		);
		background-color: var(
			--nf-accordion-color,
			light-dark(var(--nf-grey-l-40), var(--nf-grey-d-50))
		);
	}

	/*
		 * The whole disclosure animation, the collapsed height included, is gated
		 * on the two features it needs. A browser that fails the test never sees
		 * block-size: 0, so it keeps the plain instant <details> rather than a
		 * panel it cannot open.
		 */
	@supports (block-size: calc-size(auto, size)) and selector(::details-content) {
		.nf-accordion::details-content {
			block-size: 0;
			overflow: clip;
			transition-property: block-size, content-visibility;
			transition-duration: var(--nf-accordion-disclosure-duration);
			transition-timing-function: ease-in-out;
			transition-behavior: allow-discrete;
		}

		/*
			 * calc-size() rather than a bare auto: the component carries its own
			 * size interpolation instead of depending on reset.css being loaded.
			 */
		.nf-accordion[open]::details-content {
			block-size: calc-size(auto, size);
		}

		/*
			 * The content is not rendered while the panel is closed, so it has no
			 * previous value to transition from — @starting-style is what gives it
			 * one. Opening only: by the time the panel closes this box is already
			 * gone, and the shrinking panel is what the reader sees.
			 */
		.nf-accordion-content {
			opacity: 1;
			translate: 0 0;
			transition-property: opacity, translate;
			transition-duration: var(--nf-accordion-disclosure-duration);
			transition-timing-function: ease-in-out;
		}

		@starting-style {
			.nf-accordion-content {
				opacity: 0;
				/* A travel distance, not spacing: literal rather than tokenised */
				translate: 0 -8px;
			}
		}

		/*
		 * Closing drops [open] at once, but the panel takes the disclosure
		 * duration to shrink: the summary keeps its square corners and its rule
		 * until then, and switches in one step when the panel is gone. A
		 * transition takes its timing from the state being entered, so opening —
		 * which enters [open], where the delay is zero — switches immediately.
		 * Inside @supports on purpose: without the animation the panel closes
		 * instantly, and so must the corners.
		 */
		.nf-accordion-summary {
			transition-property:
				translate, background-color, color, border-color,
				border-end-start-radius, border-end-end-radius;
			transition-duration:
				var(--nf-accordion-transition-duration),
				var(--nf-accordion-transition-duration),
				var(--nf-accordion-transition-duration), 0s, 0s, 0s;
			transition-delay:
				0s, 0s, 0s, var(--nf-accordion-disclosure-duration),
				var(--nf-accordion-disclosure-duration),
				var(--nf-accordion-disclosure-duration);
		}

		.nf-accordion[open] .nf-accordion-summary {
			transition-delay: 0s;
		}
	}

	/* Keep the states and their feedback, drop the animation between them */
	@media (prefers-reduced-motion: reduce) {
		.nf-accordion {
			--nf-accordion-transition-duration: 0s;
			--nf-accordion-disclosure-duration: 0s;
		}
	}
</style>
