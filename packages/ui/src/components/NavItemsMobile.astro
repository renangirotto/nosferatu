---
import type { HTMLAttributes } from "astro/types";
import type { NavItem } from "../types/components";

interface Props extends HTMLAttributes<"ul"> {
	items: NavItem[];
}

const { items, class: className, ...attrs } = Astro.props;
---

<ul {...attrs} class:list={["nf-nav-items-mobile", className]}>
	{items.map(({ text, href, icon: Icon, current }) => (
		<li class="nf-nav-items-mobile-item">
			<a
				class="nf-nav-items-mobile-link"
				href={href}
				aria-current={current ? "page" : undefined}
			>
				{Icon && (
					<span class="nf-nav-items-mobile-icon" aria-hidden="true">
						<Icon width="1em" height="1em" stroke-width="2" />
					</span>
				)}
				{text}
			</a>
		</li>
	))}
</ul>

<style>
	.nf-nav-items-mobile {
		margin: var(--nf-spacing-none);
		padding: var(--nf-spacing-none);
		list-style: none;
	}

	/* The border color is set by an enclosing Navbar; alone, it is grey */
	.nf-nav-items-mobile-item {
		border-block-end: 1px solid
			var(
				--nf-navbar-border-color,
				light-dark(var(--nf-grey-l-30), var(--nf-grey-d-120))
			);
	}

	.nf-nav-items-mobile-link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--nf-spacing-base-low-2);
		padding: var(--nf-spacing-base);
		color: inherit;
		font-size: 1rem;
		text-decoration: none;

		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: -2px;
		}

		&[aria-current="page"] {
			color: var(
				--nf-navbar-active-color,
				light-dark(var(--nf-purple-l-70), var(--nf-purple-d-30))
			);
		}
	}

	/* Never squashed: in a tight row, the text gives way instead */
	.nf-nav-items-mobile-icon {
		display: flex;
		flex: none;
		font-size: 22px;
	}
</style>
