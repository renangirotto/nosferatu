---
/*
 * A layout renders the whole document, so it takes no native attributes and
 * merges no consumer class: the markup below is the contract.
 */
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main class="nf-layout-blog-article">
      <article>
        <h1>{title}</h1>
        <p>{description}</p>
        <slot />
      </article>
    </main>
  </body>
</html>

<style>
  .nf-layout-blog-article {
    --nf-fluid-vmin: 560px;
    --nf-fluid-vmax: 1088px;

    --nf-fluid-progress: progress(
      100svw,
      var(--nf-fluid-vmin),
      var(--nf-fluid-vmax)
    );

    --nf-fs-base: calc(1rem + var(--nf-fluid-progress) * 0.125rem);

    --nf-fs-type-scale-small: 1.2;
    --nf-fs-type-scale-large: 1.414;
    --nf-fs-type-scale: calc(
      var(--nf-fs-type-scale-small) + var(--nf-fluid-progress) *
        (var(--nf-fs-type-scale-large) - var(--nf-fs-type-scale-small))
    );

    --nf-h1: calc(var(--nf-fs-base) * pow(var(--nf-fs-type-scale), 3));
    --nf-h2: calc(var(--nf-fs-base) * pow(var(--nf-fs-type-scale), 2.5));
    --nf-h3: calc(var(--nf-fs-base) * pow(var(--nf-fs-type-scale), 2));
    --nf-h4: calc(var(--nf-fs-base) * pow(var(--nf-fs-type-scale), 1.5));
    --nf-fs-p: var(--nf-fs-base);

    h1 {
      font-size: var(--nf-h1);
    }

    h2 {
      font-size: var(--nf-h2);
    }

    h3 {
      font-size: var(--nf-h3);
    }

    h4 {
      font-size: var(--nf-h4);
    }

    p {
      font-size: var(--nf-fs-p);
    }
  }
</style>
