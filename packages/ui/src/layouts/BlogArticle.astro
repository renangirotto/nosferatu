---
/*
 * A layout renders the whole document, so it takes no native attributes and
 * merges no consumer class: the markup below is the contract.
 */
import BaseHtml from "../html/BaseHtml.astro";
import BaseHead from "../html/BaseHead.astro";

interface Props {
	title: string;
	description: string;
	lang?: string;
	imageSocialMedia?: string;
}

const { title, description, lang = "en", imageSocialMedia } = Astro.props;
---

<BaseHtml lang={lang}>
	<BaseHead
		slot="head"
		title={title}
		description={description}
		imageSocialMedia={imageSocialMedia}
	/>
	<main class="nf-layout-blog-article">
		<article class="nf-layout-blog-article-content">
			<h1>{title}</h1>
			<p>{description}</p>
			<slot />
		</article>
	</main>
</BaseHtml>

<style>
	.nf-layout-blog-article {
		/*
	   * The article's own fonts, defaulting to the library's. Going through a
	   * layout-scoped property is what lets a consumer re-tune one article
	   * without moving the page's general font.
	   */
		--nf-layout-blog-article-font-family: var(--nf-font-family-blog-post);
		--nf-layout-blog-article-font-family-code: var(
			--nf-font-family-code-blog-post
		);
		--nf-layout-blog-article-font-weight: var(--nf-font-weight);

		.nf-layout-blog-article-content {
			margin-inline: auto;
			inline-size: 100%;
			max-inline-size: var(
				--nf-layout-blog-article-max-inline-size,
				var(--nf-container-small-size)
			);
		}

		p {
			font-family: var(--nf-layout-blog-article-font-family);
			font-weight: var(--nf-layout-blog-article-font-weight);
		}

		/*
	   * Family only: a weight here would un-bold every <strong> in the article.
	   * Headings are deliberately left out — they inherit the page's general
	   * font, so an article reads as Outfit for structure and the article font
	   * for prose.
	   */
		strong,
		span,
		a {
			font-family: var(--nf-layout-blog-article-font-family);
		}

		/*
	   * A fenced code block is <pre><code>, and <pre> carries the UA's own
	   * monospace, which beats inheritance — so both need the rule.
	   */
		code,
		pre {
			font-family: var(--nf-layout-blog-article-font-family-code);
		}
	}
</style>
